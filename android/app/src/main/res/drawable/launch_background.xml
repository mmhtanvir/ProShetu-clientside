<?xml version="1.0" encoding="utf-8"?>
<!-- Solid color matching AppColors.backgroundDark, so this native launch
     screen is visually identical to the app's own SplashScreen — the OS
     shows this instantly on process start, then Flutter's first frame
     (the same color) takes over with zero visible transition. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
