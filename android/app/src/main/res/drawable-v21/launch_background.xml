<?xml version="1.0" encoding="utf-8"?>
<!-- Same solid color as drawable/launch_background.xml — kept explicit
     here rather than `?android:colorBackground` so the launch screen
     stays the app's dark splash color regardless of the OS light/dark
     setting (the app itself always launches into the dark SplashScreen). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
